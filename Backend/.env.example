PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/TaskPro?retryWrites=true&w=majority
# If mongodb+srv fails with querySrv ECONNREFUSED on Windows, paste Atlas "Standard connection string" here:
# MONGO_URI_STANDARD=mongodb://<username>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/TaskPro?ssl=true&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=your_secret_key_here
